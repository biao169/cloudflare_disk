{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clouddrive",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/s/*",
      "/t/*",
      "/p/*",
      "/",
      "/index.html",
      "/login",
      "/setup",
      "/files",
      "/personal",
      "/spaces",
      "/recent",
      "/shares",
      "/trash",
      "/users",
      "/settings"
    ]
  },
  "vars": {
    "APP_NAME": "CloudDrive",
    "APP_STAGE": "stage-12",
    "PUBLIC_BASE_URL": ""
  },
  "r2_buckets": [
    {
      "binding": "PRIVATE_BUCKET",
      "bucket_name": "clouddrive-private"
    },
    {
      "binding": "PUBLIC_BUCKET",
      "bucket_name": "clouddrive-public"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clouddrive-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
